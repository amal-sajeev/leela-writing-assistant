{
  "name": "lyra-companion",
  "version": "0.1.1",
  "description": "Story-aware AI reviews, continuity checks, and in-character chat for writers.",
  "author": "Amal Sajeev <amsajeev333@gmail.com>",
  "private": true,
  "engines": {
    "node": "22.16.x"
  },
  "packageManager": "npm@10.9.2",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:offline": "node scripts/review-eval.mjs --self-test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "install-plugin": "node scripts/vault-install.mjs",
    "assets:embed": "node scripts/optimize-embedded-assets.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run eval:offline && node esbuild.config.mjs production && node scripts/check-production-build.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "writing",
    "companion"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "builtin-modules": "5.4.0",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
